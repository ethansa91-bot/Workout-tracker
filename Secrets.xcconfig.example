// Copy this file to Secrets.xcconfig (gitignored) and fill in your own Supabase
// project's values — Project Settings > API in the Supabase dashboard.
//
// Note: "//" starts a comment in .xcconfig files, so a URL's own "//" has to be split
// with an empty macro ($()) or the line gets truncated at parse time.

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Optional — only needed for the Gemini option in the exercise image generator.
// Leave blank (or omit the line) to leave that option hidden.
GEMINI_API_KEY =

// Optional — only needed for the Hugging Face option in the exercise image generator.
// Create a free "Read" access token at https://huggingface.co/settings/tokens.
// Leave blank to leave that option hidden.
HUGGINGFACE_API_TOKEN =

INFOPLIST_KEY_SupabaseURL = $(SUPABASE_URL)
INFOPLIST_KEY_SupabaseAnonKey = $(SUPABASE_ANON_KEY)
